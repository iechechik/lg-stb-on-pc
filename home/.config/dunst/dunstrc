[global]
    monitor = 0
    follow = none
    width = 420
    height = (0, 120)
    origin = bottom-center
    offset = (40, 70)
    notification_limit = 3
    font = DejaVu Sans 26
    frame_width = 2
    frame_color = "#4a6fa5"
    separator_color = frame
    corner_radius = 12
    timeout = 3

[urgency_low]
    background = "#11151c"
    foreground = "#e6edf3"
    timeout = 1.5

[urgency_normal]
    background = "#11151c"
    foreground = "#ffffff"
    timeout = 3

[urgency_critical]
    background = "#4a1111"
    foreground = "#ffffff"
    timeout = 3
