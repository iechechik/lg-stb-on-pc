[global]
    monitor = 0
    follow = none

    # Приставка: сообщения короткие, но должны читаться с трёх метров и не рваться.
    width = 900
    height = (0, 200)
    origin = bottom-center
    offset = (0, 120)
        padding = 18
    horizontal_padding = 24
    text_icon_padding = 12
    frame_width = 3
    frame_color = "#6aa9ff"
    separator_color = frame
    corner_radius = 14
    font = DejaVu Sans 24
    alignment = left
    format = "<b>%s</b>\n%b"
    markup = full
    word_wrap = yes
    ignore_newline = no

    # Новое сообщение заменяет старое: иначе они ложатся друг на друга.
    stack = no
    indicate_hidden = no

[urgency_low]
    background = "#1e1e1e"
    foreground = "#eeeeee"
    timeout = 3

[urgency_normal]
    background = "#1e1e1e"
    foreground = "#ffffff"
    timeout = 4

[urgency_critical]
    background = "#8b1a1a"
    foreground = "#ffffff"
    timeout = 6
