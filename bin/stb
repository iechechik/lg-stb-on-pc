def _mode4k(argv):
    """Ручной режим экрана: stb mode4k [on|off|toggle|status]."""
    return stb4k.cmd(argv)


def cmd_status(argv):
    """Что сейчас с экраном и плеером: одна строка ответа на каждый вопрос."""
    mode = stb4k.video_mode()
    screen = stb4k.current_mode() or "неизвестно"
    height, paused, fps = stb4k.playing()
    if height:
        film = "%dp" % height + (", пауза" if paused else ", играет")
        if fps:
            film += ", %.3f кадр/с" % float(fps)
    else:
        film = "нет"
    print("экран:      %s" % screen)
    print("4K-режим:   %s" % {"off": "off — всегда 1080p",
                              "auto": "auto — только 4K-фильм",
                              "all": "all — любой фильм"}[mode])
    print("фильм:      %s" % film)
    print("окно Jellyfin: %s" % ("активно" if stb4k.player_active() else "не активно"))
    return 0


def cmd_boot(argv):
    """Хук загрузки: включить телевизор и сесть на вход приставки."""
    for _ in range(30):
        if tv_alive():
            break
        time.sleep(2)

    state = tv_state().get("power") or ""
    if state == "Active":
        say("boot: телевизор уже включён — пробуждение не требуется")
    elif cmd_tv_wake(["40"]) != 0:
        say("boot: телевизор не ответил — интерфейс поднимет сторож")
        return 0
    else:
        say("boot: телевизор проснулся")

    if TV_INPUT:
        cmd_tv(["setinput", TV_INPUT])
        say("boot: вход переключён на %s" % TV_INPUT)
    mode_set("nuc")
    subprocess.run([sys.argv[0], "idle", "on"], capture_output=True, timeout=60)
    close_splash_now()
    return 0




def cmd_preflight(argv):
    """Профилактика в режиме ТВ: вернуть Jellyfin, если телевизор упал или на «кабеле».

    Запускается из обработчика кнопок в фоне, не чаще раза в 15 секунд.
    """
    last = "/run/stb/preflight.last"
    try:
        age = time.time() - os.path.getmtime(last)
        if age < 15:
            return 0
    except OSError:
        pass
    try:
        mark_set(last)
    except OSError:
        return 0

    app = current_app()
    if not app:
        say("preflight: ТВ не отвечает — бужу")
        if cmd_tv_wake(["30"]) != 0:
            say("preflight: разбудить не удалось")
            return 0
        for attempt in range(1, 4):
            if TV_APP:
                cmd_tv(["app", TV_APP])
            time.sleep(2)
            if TV_APP and TV_APP in current_app():
                say("preflight: проснулся и запустил приложение (попытка %d)" % attempt)
                return 0
        say("preflight: проснулся, но приложение не вышло")
    return 0


