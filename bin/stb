# ═══════════════════════════════════════════════════════════ сторож заставки









def do_poweroff(argv):
    """Выключить приставку. Телевизор гасит хук выключения (stb-tv-shutdown):
    один механизм для кнопки корпуса, shutdown -h и плитки, с ожиданием
    подтверждения ожидания. Здесь только выключение."""
    dry = "--dry-run" in argv
    if dry:
        print("пробный прогон: приставка осталась включённой")
        return 0
    # --keep-tv: телевизор оставить включённым. Отметку читает хук выключения.
    mark = "/run/stb/keep-tv"
    try:
        if "--keep-tv" in argv:
            with open(mark, "w", encoding="utf-8") as f:
                f.write("1")
            key_log("выключение: телевизор просили оставить включённым")
        elif os.path.exists(mark):
            os.remove(mark)
    except OSError:
        pass
    print("выключаю приставку")
    return subprocess.run(["sudo", "-n", "systemctl", "poweroff"]).returncode


def cmd_poweroff(argv):
    """Выключить приставку: первое нажатие взводит, второе в течение 10 с — выключает."""
    arm = "/run/stb/poweroff-armed"
    if "--now" in argv:
        return do_poweroff(argv)

    try:
        if os.path.exists(arm) and time.time() - os.path.getmtime(arm) <= 10:
            os.remove(arm)
            return do_poweroff(argv)
    except OSError:
        pass

    try:
        with open(arm, "w", encoding="utf-8") as f:
            f.write(str(time.time()))
    except OSError:
        print("не смог поставить отметку в /run/stb", file=sys.stderr)
        return 1
    print("нажми ещё раз в течение 10 секунд, чтобы выключить приставку "
          "(телевизор погаснет вместе с ней)")
    return 0


































