# ═══════════════════════════════════════════════════════════ сеть и плеер

def cmd_nic_watch(argv):
    """Проверить новые зависания сетевого чипа и, если есть, сбросить линк."""
    state = "/run/stb/nic_hangs"
    dmesg = subprocess.run(["dmesg"], capture_output=True, text=True).stdout
    now = dmesg.count("Hardware Unit Hang")
    try:
        last = int(open(state, encoding="utf-8").read().strip() or 0)
    except (OSError, ValueError):
        last = 0
    try:
        with open(state, "w", encoding="utf-8") as f:
            f.write(str(now))
    except OSError:
        pass
    if now > last and last != 0:
        import syslog
        syslog.syslog("новые зависания NIC: %d → %d, сбрасываю линк" % (last, now))
        subprocess.run(["ip", "link", "set", TV_IF, "down"], capture_output=True)
        time.sleep(3)
        subprocess.run(["ip", "link", "set", TV_IF, "up"], capture_output=True)
        time.sleep(4)
        link = subprocess.run(["ethtool", TV_IF], capture_output=True, text=True).stdout
        state_line = [row for row in link.splitlines() if "Link detected" in row]
        syslog.syslog("линк поднят: %s" % (state_line[0].split()[-1] if state_line else "?"))
    return 0












