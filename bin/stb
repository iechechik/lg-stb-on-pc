# ═══════════════════════════════════════════════════════════ карты кнопок



def cmd_keys(argv):
    """Карты кнопок: stb keys apply bt [--dry-run] | stb keys apply wifi."""
    if len(argv) < 2 or argv[0] != "apply":
        print("usage: stb keys apply bt [--dry-run] | stb keys apply wifi", file=sys.stderr)
        return 2
    what = argv[1]
    if what == "bt":
        return bt_keys_apply("--dry-run" in argv)
    if what == "wifi":
        rc = subprocess.run(["systemctl", "restart", "stb-wifi-remote"]).returncode
        print("карта buttons-wifi.conf применена: приёмник перезапущен")
        return rc
    print("неизвестная карта: %s" % what, file=sys.stderr)
    return 2


# ═══════════════════════════════════════════════════════════ Bluetooth-пульт



def pair_log(msg):
    """Сопряжение пульта: в pair.log и на экран (его читают вручную)."""
    log_to("pair", msg, echo=True)


def bt(*args, timeout=30):
    try:
        return subprocess.run(["bluetoothctl"] + list(args), capture_output=True,
                              text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return subprocess.CompletedProcess(["bluetoothctl"], 1, stdout="", stderr="")


def bt_power():
    bt("power", "on")
    bt("pairable", "on")


def pair_window(seconds):
    bt_power()
    bt("discoverable-timeout", str(seconds))
    bt("discoverable", "on")
    show = bt("show").stdout
    name = ""
    for line in show.splitlines():
        if line.strip().startswith("Name:"):
            name = line.split(":", 1)[1].strip()
            break
    if "Discoverable: yes" not in show:
        pair_log("не удалось включить видимость — проверьте bluetooth.service")
        return 1
    os.makedirs("/run/stb", exist_ok=True)
    with open("/run/stb/pair_until", "w", encoding="utf-8") as f:
        f.write(str(int(time.time()) + seconds))
    pair_log("видим как «%s» %d с — сопрягайте телефон" % (name, seconds))
    # погасить видимость по времени
    subprocess.Popen(["/bin/sh", "-c",
                      "sleep %d; bluetoothctl discoverable off >/dev/null 2>&1;"
                      " rm -f /run/stb/pair_until" % seconds],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, encoding="utf-8")
    paired = bt("devices", "Paired").stdout.replace("Device ", "").split("\n")
    pair_log("уже сопряжены: %s" % " ".join(x.strip() for x in paired if x.strip()))
    return 0


def bt_find(want):
    if ":" in want:
        return want.upper()
    for line in bt("devices").stdout.splitlines():
        parts = line.split(" ", 2)
        if len(parts) < 3:
            continue
        mac, name = parts[1], parts[2]
        if want.lower() in name.lower():
            return mac
    return ""


def pair_scan(seconds):
    bt_power()
    pair_log("ищу устройства %d с…" % seconds)
    bt("--timeout", str(seconds), "scan", "on", timeout=seconds + 10)
    print("  найдено:")
    for line in bt("devices").stdout.splitlines():
        print("    " + line)
    pair_log("поиск завершён")
    return 0


def pair_list():
    print("  сопряжены:")
    for line in bt("devices", "Paired").stdout.splitlines():
        print("    " + line)
    print("  подключены сейчас:")
    for line in bt("devices", "Connected").stdout.splitlines():
        print("    " + line)
    return 0


def pair_connect(who):
    if not who:
        print("укажи имя или MAC: stb pair connect IgChe", file=sys.stderr)
        return 2
    bt_power()
    mac = bt_find(who)
    if not mac:
        pair_log("«%s» пока не видно — ищу 20 секунд" % who)
        bt("--timeout", "20", "scan", "on", timeout=30)
        mac = bt_find(who)
    if not mac:
        pair_log("не нашёл «%s»: запустите сопряжение на телефоне; список — stb pair scan 20" % who)
        return 1
    pair_log("нашёл: %s" % mac)
    if "Paired: yes" not in bt("info", mac).stdout:
        pair_log("сопрягаю (на телефоне может появиться запрос)")
        out = bt("pair", mac, timeout=60).stdout.strip().splitlines()
        print("\n".join("  " + line for line in out[-2:]))
    bt("trust", mac)
    pair_log("подключаюсь")
    out = bt("connect", mac, timeout=60).stdout.strip().splitlines()
    print("\n".join("  " + line for line in out[-2:]))
    time.sleep(2)
    if "Connected: yes" in bt("info", mac).stdout:
        pair_log("подключено: %s" % mac)
        try:
            with open("/var/lib/stb/bt-remotes", "a", encoding="utf-8") as f:
                f.write(mac + "\n")
            lines = sorted(set(open("/var/lib/stb/bt-remotes", encoding="utf-8").read().split()))
            with open("/var/lib/stb/bt-remotes", "w", encoding="utf-8") as f:
                f.write("\n".join(x for x in lines if x) + "\n")
        except OSError:
            pass
        return 0
    pair_log("подключиться не удалось: stb pair scan 30, затем stb pair connect <MAC>")
    return 1


def cmd_pair(argv):
    """Окно сопряжения и поиск телефона-пульта."""
    if not argv:
        return pair_window(180)
    what = argv[0]
    if what.isdigit():
        return pair_window(int(what))
    if what in ("scan", "-s"):
        return pair_scan(int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 30)
    if what in ("list", "-l"):
        return pair_list()
    if what in ("connect", "-c"):
        return pair_connect(argv[1] if len(argv) > 1 else "")
    if what in ("-h", "--help"):
        return cmd_help(["pair"])
    print("usage: stb pair [секунды] | stb pair scan [секунды] | stb pair list | "
          "stb pair connect ИМЯ|MAC", file=sys.stderr)
    return 2


# ═══════════════════════════════════════════════════════════ масштаб страниц

ZOOM_SITES = {"misc": "misc.local", "youtube": "www.youtube.com", "google": "www.google.com"}


ZOOM_DB = os.path.join(STB_HOME, ".mozilla/stb/content-prefs.sqlite")


def _zoom_conn(path):
    import sqlite3
    con = sqlite3.connect(path)
    cur = con.cursor()
    cur.execute("select id from settings where name='zoom-zoom'")
    row = cur.fetchone()
    if row:
        sid = row[0]
    else:
        cur.execute("insert into settings(name) values('zoom-zoom')")
        sid = cur.lastrowid
    return con, cur, sid


def _zoom_group(cur, host):
    cur.execute("select id from groups where name=?", (host,))
    row = cur.fetchone()
    if row:
        return row[0]
    cur.execute("insert into groups(name) values(?)", (host,))
    return cur.lastrowid


def user_systemctl(*args):
    """systemctl --user от имени пользователя приставки."""
    import pwd
    uid = pwd.getpwnam(STB_USER).pw_uid
    return subprocess.run(["sudo", "-n", "-u", STB_USER, "env",
                           "XDG_RUNTIME_DIR=/run/user/%d" % uid,
                           "systemctl", "--user", *args],
                          capture_output=True, timeout=30)


def cmd_zoom(argv):
    """Масштаб страниц по сайтам: stb zoom [misc|youtube|google] [проценты]."""
    import shutil
    import tempfile

    if not argv:
        tmp = os.path.join(tempfile.gettempdir(), "stb-zoom-read.sqlite")
        try:
            shutil.copy2(ZOOM_DB, tmp)
        except OSError:
            tmp = ZOOM_DB
        con, cur, sid = _zoom_conn(tmp)
        print("текущий масштаб:")
        for key, host in ZOOM_SITES.items():
            cur.execute("select id from groups where name=?", (host,))
            row = cur.fetchone()
            value = None
            if row:
                cur.execute("select value from prefs where groupID=? and settingID=?", (row[0], sid))
                got = cur.fetchone()
                value = got[0] if got else None
            print("  %-8s %-18s %s" % (key, host, value if value else "по умолчанию (100)"))
        con.close()
        return 0

    if len(argv) == 1 and argv[0].isdigit():
        key, percent = "misc", int(argv[0])
    elif len(argv) == 2 and argv[0] in ZOOM_SITES and argv[1].isdigit():
        key, percent = argv[0], int(argv[1])
    else:
        print("usage: stb zoom [misc|youtube|google] ПРОЦЕНТЫ", file=sys.stderr)
        return 2
    if not 50 <= percent <= 400:
        print("масштаб задавать в процентах, от 50 до 400", file=sys.stderr)
        return 2

    user_systemctl("stop", "stb-browser")
    time.sleep(3)
    host = ZOOM_SITES[key]
    con, cur, sid = _zoom_conn(ZOOM_DB)
    gid = _zoom_group(cur, host)
    cur.execute("select value from prefs where groupID=? and settingID=?", (gid, sid))
    old = cur.fetchone()
    if old:
        cur.execute("update prefs set value=?, timestamp=? where groupID=? and settingID=?",
                    (percent, int(time.time()), gid, sid))
    else:
        cur.execute("insert into prefs(groupID, settingID, value, timestamp) values(?,?,?,?)",
                    (gid, sid, percent, int(time.time())))
    con.commit()
    con.close()
    print("  %s: %s → %d%%" % (host, old[0] if old else "—", percent))
    user_systemctl("start", "stb-browser")
    return 0


# ═══════════════════════════════════════════════════════════ службы

def cmd_ctl(argv):
    what = argv[0] if argv else "status"
    user = ["sudo", "-n", "-u", STB_USER, "env",
            "XDG_RUNTIME_DIR=/run/user/%s" % subprocess.run(["id", "-u", STB_USER],
                                                            capture_output=True, text=True).stdout.strip()]

    def active(unit, is_user=False):
        cmd = user + ["systemctl", "--user", "is-active", unit] if is_user else \
              ["systemctl", "is-active", unit]
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip() or "—"

    def enabled(unit, is_user=False):
        cmd = user + ["systemctl", "--user", "is-enabled", unit] if is_user else \
              ["systemctl", "is-enabled", unit]
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip() or "—"

    system = ["stb-tv-link", "stb-wifi-remote", "stb-watch", "stb-nic-watch.timer"]
    session = ["stb-web", "stb-browser", "stb-screensaver"]

    if what in ("restart", "stop", "start"):
        if what == "restart":
            subprocess.run(["systemctl", "restart", "stb.target"])
            subprocess.run(user + ["systemctl", "--user", "restart", "stb-web", "stb-browser"])
        elif what == "stop":
            subprocess.run(user + ["systemctl", "--user", "stop", "stb-browser", "stb-web"])
            subprocess.run(["systemctl", "stop", "stb.target"])
        else:
            subprocess.run(["systemctl", "start", "stb.target"])
            subprocess.run(user + ["systemctl", "--user", "start", "stb-web", "stb-browser"])
        time.sleep(3)

    print("%-24s %-10s %s" % ("СЛУЖБА", "СОСТОЯНИЕ", "ВКЛЮЧЕНА"))
    for unit in system:
        print("%-24s %-10s %s" % (unit, active(unit), enabled(unit)))
    for unit in session:
        print("%-24s %-10s %s" % (unit + " (user)", active(unit, True), enabled(unit, True)))
    return 0


# ═══════════════════════════════════════════════════════════ сессия

def cmd_session(argv):
    """Сессия приставки: openbox, панель уведомлений, привязки, браузер."""
    log_path = "/var/log/stb/session.log"
    env = user_env()

    def log(msg):
        try:
            with open(log_path, "a", encoding="utf-8") as f:
                f.write("%s %s\n" % (time.strftime("%F %T"), msg))
        except OSError:
            pass

    log("сессия: старт")
    # Частоту задаём сами: без --rate xrandr берёт самую быструю из EDID, а
    # 1080p120 на этом телевизоре держится нестабильно (HPD-всплески и провалы
    # картинки во время фильма).
    rate = str(stbconf.get("DISPLAY_RATE", "60") or "60")
    out = subprocess.run(["xrandr"], env=env, capture_output=True, text=True).stdout
    for line in out.splitlines():
        if " connected" in line:
            subprocess.run(["xrandr", "--output", line.split()[0], "--mode", "1920x1080",
                            "--rate", rate], env=env, capture_output=True)
            break
    subprocess.run(["xset", "-dpms", "s", "off"], env=env, capture_output=True)
    subprocess.run(["xset", "s", "off"], env=env, capture_output=True)

    for extra in ("xfce4-panel", "xfdesktop", "xfwm4", "dunst", "xbindkeys"):
        subprocess.run(["pkill", "-x", extra], capture_output=True)

    # Раскладка одна и навсегда — us: приставка набирает латиницу (адреса,
    # логины, пароли), а кириллицу браузер принимает и в us (проверено: «найди
    # hermes» набирается верно). Переключений нет, значит и путаницы нет.
    subprocess.run(["setxkbmap", "us"], env=env, capture_output=True)

    subprocess.Popen(["dunst"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, encoding="utf-8")
    try:
        openbox_log = open("/var/log/stb/openbox.log", "a", encoding="utf-8")
    except OSError:
        openbox_log = subprocess.DEVNULL      # журнала нет — сессия всё равно нужна
    subprocess.Popen(["openbox", "--sm-disable"], env=env,
                     stdout=openbox_log, stderr=openbox_log)
    time.sleep(1)

    subprocess.Popen(["xbindkeys", "-n"], env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, encoding="utf-8")
    time.sleep(1)

    # веб-страница: если служба не отвечает — поднимаем сами
    import urllib.request
    try:
        urllib.request.urlopen("http://127.0.0.1:%s/api/buttons" %
                               stbconf.get("STB_WEB_PORT", "8090"), timeout=2)
    except Exception:  # noqa: BLE001
        subprocess.Popen(["/usr/bin/python3", "/opt/stb/web/stb-web.py"], env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, encoding="utf-8")

    cmd_mode(["nuc"])
    if as_user("systemctl", "--user", "start", "stb-browser").returncode != 0:
        log("user-служба недоступна — запускаю браузер напрямую")
        while True:
            subprocess.run(["/usr/bin/firefox-esr", "--kiosk", "--no-remote", "--profile",
                            os.path.join(STB_HOME, ".mozilla/stb"),
                            "http://127.0.0.1:%s/" % stbconf.get("STB_WEB_PORT", "8090")], env=env)
            time.sleep(2)

    while True:
        time.sleep(30)


