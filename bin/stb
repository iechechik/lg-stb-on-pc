#!/usr/bin/env python3
"""stb — одна команда для всего, что делает приставка.

    stb tv on|off|status|powerstate
    stb tv key UP | stb tv up | stb tv down | stb tv mute | stb tv unmute
    stb tv vol 12 | stb tv setinput HDMI_3 | stb tv app com.webos.app.browser
    stb tv speakers | stb tv speaker external_arc | stb tv speaker-auto
    stb tv getinputs | stb tv getapps | stb tv autooff15min [on|off]

    stb mode [nuc|tv]        текущий режим пульта или переключить
    stb toggle               приставка ↔ телевизор одной командой
    stb live                 перейти на телевизор, источник не меняется
    stb box                  вернуть вход приставки
    stb jelly                запустить Jellyfin на телевизоре
    stb close                закрыть активное окно (сетку не трогаем)

    stb key <действие>       кнопка пульта с учётом режима
    stb ctl [status|restart|stop|start]   службы комплекса

Если программу вызвать как `tv`, она делает то же, что `stb tv`:
это одна и та же программа под двумя именами.
"""
import os
import subprocess
import time
import sys

sys.path.insert(0, "/opt/stb/lib")
import stbconf  # noqa: E402
from stbcommon import (STB_HOME, STB_USER, as_user, current_app, key_log,
                       log_to, mark_set, mode_set, say, tv_alive, user_env)
from stbsvc import cmd_service  # noqa: E402
import stb4k  # noqa: E402
from stbdesktop import cmd_login  # noqa: E402
from stbdesktop import close_splash_now  # noqa: E402
from stbdesktop import cmd_browser  # noqa: E402
from stbdesktop import cmd_box  # noqa: E402
from stbdesktop import cmd_close  # noqa: E402
from stbdesktop import cmd_jelly  # noqa: E402
from stbdesktop import cmd_live  # noqa: E402
from stbdesktop import cmd_mode  # noqa: E402
from stbdesktop import cmd_sound  # noqa: E402
from stbdesktop import cmd_toggle  # noqa: E402
from stbdesktop import cmd_grid  # noqa: E402
from stbdesktop import cmd_hide  # noqa: E402
from stbdesktop import cmd_idle  # noqa: E402
from stbdesktop import cmd_player  # noqa: E402
