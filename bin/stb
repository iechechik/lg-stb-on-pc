def help_text(topic=None):
    if topic and topic in HELP:
        title, rows = HELP[topic]
        out = ["stb %s — %s" % (topic, title), ""]
        for usage, what in rows:
            out.append("  %-46s %s" % (usage, what))
        return "\n".join(out)
    out = ["stb — одна команда для приставки", "", "Разделы:"]
    for name, (title, _rows) in HELP.items():
        out.append("  %-10s %s" % (name, title))
    out += ["", "Подробнее: stb help <раздел>, например stb help tv",
            "Короткое имя: tv — то же, что stb tv"]
    return "\n".join(out)


def help_markdown():
    """Та же справка в markdown: docs/COMMANDS.md собирается из неё."""
    out = ["# Команды `stb`", "",
           "Документ собран из самой программы: `stb help --markdown`.", ""]
    for name, (title, rows) in HELP.items():
        out.append("## %s — %s" % (name, title))
        out.append("")
        out.append("| команда | что делает |")
        out.append("|---|---|")
        for usage, what in rows:
            out.append("| `%s` | %s |" % (usage.replace("|", "\\|"), what))
        out.append("")
    return "\n".join(out)


def cmd_help(argv):
    if argv and argv[0] == "--markdown":
        print(help_markdown())
        return 0
    print(help_text(argv[0] if argv else None))
    return 0


COMMANDS = {
    "tv": cmd_tv,
    "mode": cmd_mode,
    "toggle": cmd_toggle,
    "box": cmd_box,
    "jelly": cmd_jelly,
    "live": cmd_live,
    "close": cmd_close,
    "hide": cmd_hide,
    "grid": cmd_grid,
    "ui": cmd_ui,
    "sound": cmd_sound,
    "hidden": lambda argv: hidden_check() if not argv or argv[0] == "check" else 2,
    "lang": cmd_lang,
    "ctl": cmd_ctl,
    "boot": cmd_boot,
    "preflight": cmd_preflight,
    "zoom": cmd_zoom,
    "key": cmd_key,
    "help": cmd_help,
    "pair": cmd_pair,
    "keys": cmd_keys,
    "idle": cmd_idle,
    "screen": cmd_screen,
    "browser": cmd_browser,
    "session": cmd_session,
    "nic-watch": cmd_nic_watch,
    "player": cmd_player,
    "screensaver": cmd_screensaver,
    "poweroff": cmd_poweroff,
}
def main(argv):
    name = os.path.basename(argv[0])
    args = argv[1:]

    # вызов как `tv` — это сокращение для `stb tv`
    if name == "tv":
        return cmd_tv(args) if args else cmd_tv(["status"])

    if not args:
        print(help_text())
        return 2
    if args[0] in ("-h", "--help", "help"):
        return cmd_help(args[1:])

    if len(args) > 1 and args[1] in ("-h", "--help"):
        return cmd_help([args[0]])

    cmd = COMMANDS.get(args[0])
    if not cmd:
        print("неизвестная команда: %s" % args[0], file=sys.stderr)
        print("команды: %s" % ", ".join(COMMANDS), file=sys.stderr)
        return 2
    return cmd(args[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
