[Unit]
Description=STB: постоянное соединение с телевизором
Documentation=file:///opt/stb/docs/SYSTEM.md
After=network-online.target
PartOf=stb.target

[Service]
Type=simple
User=stbuser
Environment=HOME=/home/stbuser
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/stb/bin/stb-tv-link
Restart=always
RestartSec=3

[Install]
WantedBy=stb.target
