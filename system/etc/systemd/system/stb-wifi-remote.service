[Unit]
PartOf=stb.target
Description=STB: приёмник кнопок от приложения-пульта (представляется телевизором LG)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/stbuser/.Xauthority
ExecStart=/usr/bin/python3 /opt/stb/bin/stb-wifi-remote
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
